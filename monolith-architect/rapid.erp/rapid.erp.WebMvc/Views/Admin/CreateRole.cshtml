@model rapid.erp.ViewModel.Security.ApplicationRoleCreateViewModel
@{
    ViewData["Title"] = "Create Role";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row mb-4">
    <div class="col-10">
        <h1 class="f-26">Create Role</h1>
    </div>
    <div class="col-2 text-right">
        <a href="@Url.Action("Role", "Admin", new { Area = "" })" title="Back" class="btn btn-secondary">Back</a>
    </div>
</div>

@Html.RenderAlert("RoleMessage")

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <form method="post" asp-action="CreateRole" asp-controller="Admin">
                    <div class="form-body">

                        <div class="form-group row">
                            <label asp-for="Name" class="col-3 control-label"></label>
                            <div class="col-4">
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name"></span>
                            </div>
                        </div>

                    </div>
                    <div class="form-actions form-actions-new">
                        <div class="row">
                            <div class="col-12">
                                <input type="submit" class="btn btn-primary" value="Submit" />
                                <a href="@Url.Action("Role", "Admin", new { Area = "" })" title="Back" class="btn btn-danger ml-2">Cancel</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

