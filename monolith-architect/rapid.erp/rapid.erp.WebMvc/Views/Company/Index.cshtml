@model IEnumerable<rapid.erp.ViewModel.Admin.CompanyViewModel>
@{
    ViewData["Title"] = "All Company";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row mb-4">
    <div class="col-8">
        <h1 class="f-26">All Company</h1>
    </div>
    <div class="col-4 text-right">
        <a href="@Url.Action("Add", "Company", new { Area = "" })" title="Add Company" class="btn btn-primary">Add Company</a>
    </div>
</div>

@Html.RenderAlert("CompanyMessage")

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <table class="table table-sm table-bordered table-bordered">
                    <tr>
                        <th>Name</th>
                        <th>Address</th>
                        <th></th>
                    </tr>
                    @if (Model.Count() == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center">@MessageHelper.DataNotFound</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.NameEnglish</td>
                                <td>@item.Address</td>
                                <td>
                                    <form asp-action="Delete" asp-route-id="@item.CompanyId" method="post">
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/admin/js/contact-us-config.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            Company.LoadDataTables('dataTablesCompany', App.DisplayLength(), ("/Company/GetDataAsync"));
        });
    </script>
}
